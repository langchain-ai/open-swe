{
  "version": 2,
  "name": "demo",
  "language": "python",
  "instructions": "Research with the tools you have.",
  "model": "openai:gpt-5.6-terra",
  "sandbox": false,
  "memory": "agent",
  "channels": [],
  "mcp_definitions": [
    {
      "name": "mcp",
      "servers": [
        {
          "key": "langchain-docs",
          "url": "https://docs.langchain.com/mcp",
          "include_tools": [
            "search_docs_by_lang_chain"
          ]
        },
        {
          "key": "acme-2",
          "url": "https://mcp.acme.dev/mcp",
          "connection": {
            "slug": "acme-2",
            "owner": "agent"
          },
          "include_tools": [
            "lookup"
          ],
          "commented_out": "After your first `mda deploy`, set `ACME_2_TOKEN` to the token (without `Bearer `) and run `mda connections create acme-2 --secret-from-env ACME_2_TOKEN`.\nThen uncomment this server and deploy again."
        },
        {
          "key": "github-2",
          "url": "https://mcp.github.example/mcp",
          "connection": {
            "slug": "github-2",
            "owner": "user"
          },
          "include_tools": [
            "list_repos"
          ]
        },
        {
          "key": "notion",
          "url": "https://mcp.notion.com/mcp",
          "connection": {
            "slug": "notion",
            "owner": "user"
          },
          "include_tools": [
            "create_page",
            "search"
          ]
        },
        {
          "key": "weather",
          "url": "https://weather.example.com/mcp",
          "include_tools": [
            "forecast"
          ]
        }
      ]
    }
  ],
  "interrupt_on": {
    "notion_create_page": {
      "allowed_decisions": [
        "approve",
        "reject"
      ],
      "description": "Creates a \"page\""
    }
  }
}
