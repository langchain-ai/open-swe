{
  "version": 2,
  "name": "demo",
  "language": "python",
  "instructions": "Triage the team's work.",
  "model": "openai:gpt-5.6-terra",
  "sandbox": false,
  "memory": "agent",
  "channels": [],
  "mcp_definitions": [
    {
      "name": "mcp",
      "servers": [
        {
          "key": "notion",
          "url": "https://mcp.notion.com/mcp",
          "connection": {
            "slug": "notion",
            "owner": "agent"
          },
          "include_tools": [
            "search"
          ],
          "commented_out": "After your first `mda deploy`, run `mda connections create notion --mcp https://mcp.notion.com/mcp --authorize` and sign in to the account every caller shares.\nThen uncomment this server and deploy again."
        }
      ]
    },
    {
      "name": "issue_triager_subagent_mcp",
      "servers": [
        {
          "key": "linear",
          "url": "https://mcp.linear.app/mcp",
          "connection": {
            "slug": "linear",
            "owner": "agent"
          },
          "include_tools": [
            "list_issues"
          ],
          "commented_out": "After your first `mda deploy`, run `mda connections create linear --mcp https://mcp.linear.app/mcp --authorize` and sign in to the account every caller shares.\nThen uncomment this server and deploy again."
        }
      ]
    }
  ],
  "subagents": [
    {
      "name": "issue triager",
      "description": "Looks up Linear issues.",
      "system_prompt": "You triage Linear issues.",
      "mcp": [
        "issue_triager_subagent_mcp"
      ]
    },
    {
      "name": "notion reader",
      "description": "Reads Notion pages.",
      "system_prompt": "You read Notion pages.",
      "mcp": [
        "mcp"
      ]
    }
  ]
}
