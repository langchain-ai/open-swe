{
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "ui/src/styles.css",
    "functions": [
      "cn",
      "cva"
    ]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    ".venv/**",
    "**/*.md",
    "**/*.json",
    "**/*.jsonc",
    "**/*.yaml",
    "**/*.yml",
    "**/*.toml",
    "**/*.css",
    "**/*.html",
    "ui/.output/**",
    "ui/.nitro/**",
    "ui/.tanstack/**",
    "ui/dev-dist/**",
    "ui/dist/**",
    "desktop/build/**",
    "ui/src/routeTree.gen.ts"
  ]
}
