{
  "name": "open-swe-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Open SWE command-line client: runs a cloud agent against a local checkout",
  "type": "module",
  "scripts": {
    "build": "bun run compile --outfile dist/oswe",
    "compile": "bun build --compile --minify --no-compile-autoload-dotenv src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "open-swe-bridge-client": "workspace:*",
    "zod": "^4.6.5"
  }
}
