gzip -c <transcript_path> | curl -fsS -X POST -H 'Authorization: Bearer {{ upload_token }}' -H 'Content-Type: application/x-ndjson' -H 'Content-Encoding: gzip' --data-binary @- '{{ upload_url }}'
```

