{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import", "unicorn", "oxc", "vitest"],
  "jsPlugins": [
    { "name": "query", "specifier": "@tanstack/eslint-plugin-query" },
    { "name": "router", "specifier": "@tanstack/eslint-plugin-router" },
    { "name": "invalidations", "specifier": "./ui/lint/no-polling-plugin.mjs" }
  ],
  "categories": { "correctness": "error" },
  "rules": {
    "react-hooks/exhaustive-deps": "warn",
    "vitest/require-mock-type-parameters": "off",
    "query/exhaustive-deps": "error",
    "query/no-unstable-deps": "error",
    "query/no-rest-destructuring": "warn",
    "router/create-route-property-order": "error",
    "no-shadow": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    ".venv/**",
    "ui/.output/**",
    "ui/.nitro/**",
    "ui/.tanstack/**",
    "ui/dev-dist/**",
    "ui/dist/**",
    "ui/public/**",
    "ui/src/routeTree.gen.ts",
    "ui/src/components/ui/**",
    "ui/src/features/agents/experiments/**",
    "desktop/build/**"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.cjs"],
      "rules": { "react/globals": "off" }
    },
    {
      "files": ["ui/src/**/*.ts", "ui/src/**/*.tsx"],
      "rules": { "invalidations/no-polling": "error" }
    },
    {
      "files": [
        "ui/src/**/*.test.ts",
        "ui/src/**/*.test.tsx",
        "ui/src/features/agents/components/AgentsSidebar.tsx",
        "ui/src/features/agents/components/PlanReview.tsx",
        "ui/src/features/agents/components/PlanView.tsx",
        "ui/src/features/agents/components/ThreadFeedbackCard.tsx",
        "ui/src/features/agents/lib/desktopLocal.ts",
        "ui/src/features/agents/lib/legacyLocal.ts",
        "ui/src/features/agents/lib/prChecks.ts",
        "ui/src/features/agents/lib/queries.ts",
        "ui/src/features/assistant/AssistantProvider.tsx",
        "ui/src/features/reviews/page/queries.ts",
        "ui/src/lib/query.ts",
        "ui/src/routes/admin_.evals.tsx",
        "ui/src/routes/usage.tsx"
      ],
      "rules": { "invalidations/no-polling": "off" }
    }
  ]
}
