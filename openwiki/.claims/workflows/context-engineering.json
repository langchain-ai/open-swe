  "claims": [
    {
      "id": "claim_f74600ffb8e946c4a3ad8570b5d8bb18",
      "statement": "For a PR review, the reviewer fetches AGENTS.md deterministically from the GitHub Contents API at the PR base SHA rather than relying on the model to clone and read it; fetch_agents_md tries AGENTS.md then CLAUDE.md but only falls through on a 404, returning None for any other non-200 status.",
      "evidence": [
        {
          "resource": "repo://agent/reviewer.py#L1150-L1162",
          "version": "repo-lines-v1:sha256:d9fc3974295a6f8ab8a34216c868fa7cb22ffef42a6858458d946e3994736c71:"
        },
        {
          "resource": "repo://agent/utils/agents_md.py#L46-L116",
          "version": "repo-lines-v1:sha256:8d6a152c0b929416eff5ab0e8e599f10b034eeb624b6fda541dc7a15671b6a1c:"
        }
      ]
    },
    {
      "id": "claim_db57a05fb20e4fdd925d2afd07084478",
      "statement": "fetch_agents_md caps inlined AGENTS.md/CLAUDE.md content at 64 KiB (_MAX_AGENTS_MD_BYTES) and returns None for oversize files so an accidentally huge conventions doc does not bloat every reviewer prompt.",
      "evidence": [
        {
          "resource": "repo://agent/utils/agents_md.py#L17-L20",
          "version": "repo-lines-v1:sha256:c88ee3eb6e936b6678ad6b0c8ef180a93a7e5cd40786c7b111826277d4e1cee6:"
