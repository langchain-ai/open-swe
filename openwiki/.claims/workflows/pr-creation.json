  "claims": [
    {
      "id": "claim_1e087483ed7d4f6789eaef708ca65bca",
      "statement": "New pull requests are opened through the open_pull_request tool (not shell gh pr create), which requires the branch to already be pushed to origin, takes owner/repo/head/base/title/body, and returns a result whose created flag distinguishes a newly opened PR from an already-existing one.",
      "evidence": [
        {
          "resource": "repo://agent/tools/open_pull_request.py#L905-L958",
          "version": "repo-lines-v1:sha256:f578f7b248c356cf0868ddbc257c02bc4f6f014acfa85f2fc4549c9ec20d54da:"
        }
      ]
    },
    {
      "id": "claim_f263bf43bb7544f0afa00798b2c201fd",
      "statement": "open_pull_request attributes the PR to the triggering user: _resolve_pr_author_token prefers the user's OAuth token resolved fresh by GitHub login (for slack/linear/dashboard sources) so the PR is authored as that person, and falls back to the GitHub App installation token (open-swe[bot]) for GitHub-triggered runs, unmapped users, or bot-only deployments.",
      "evidence": [
        {
          "resource": "repo://agent/tools/open_pull_request.py#L51-L76",
          "version": "repo-lines-v1:sha256:2ccfd3bbf4cd262a45d368869c37bf19f5dd3331938636626729f477d8086b3a:"
        }
      ]
    },
    {
      "id": "claim_517d178b29504b6c9835717912b0e1f1",
      "statement": "Before creating a PR, open_pull_request runs a preflight that GETs the repository and the base and applicable same-owner head branches, returning specific failure codes (github_app_access_missing_or_repo_not_found, github_pr_branch_not_visible, github_pr_preflight_failed) with a summary of GitHub's actual status, selected headers, and truncated body instead of an opaque error.",
      "evidence": [
        {
          "resource": "repo://agent/tools/open_pull_request.py#L293-L432",
          "version": "repo-lines-v1:sha256:557a1676bb6f61c1fb385e48428e8be627556d15cfbc97817c0288b5bab91769:"
