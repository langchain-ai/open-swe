    {
      "id": "claim_1e087483ed7d4f6789eaef708ca65bca",
      "statement": "New pull requests are opened through the open_pull_request tool (not shell gh pr create), which requires the branch to already be pushed to origin, takes owner/repo/head/base/title/body, and returns a result whose created flag distinguishes a newly opened PR from an already-existing one.",
      "evidence": [
        {
          "resource": "repo://agent/tools/open_pull_request.py#L1038-L1168",
          "version": "repo-lines-v1:sha256:952dc6e4592c695c659c070fc971aa0d9c4fe3f410e167abe6112250af3a6e21:"
        }
      ]
    },
    {
      "id": "claim_f263bf43bb7544f0afa00798b2c201fd",
      "statement": "open_pull_request resolves a requested or triggering thread participant to that person's valid GitHub OAuth token, and uses the GitHub App installation token only when no participant author applies; an unavailable user token or an author who is not a thread participant is reported as a failure rather than silently changing attribution.",
      "evidence": [
