        {
          "resource": "repo://agent/tools/open_pull_request.py#L1009-L1084",
          "version": "repo-lines-v1:sha256:087fcc4e7bdd8895cf1778d09f770c0700f2b48c6536531d7c1a67eec672250d:"
        }
      ]
    },
