        {
          "resource": "repo://agent/dispatch.py#L242-L257",
          "version": "repo-lines-v1:sha256:934978f6486dbd2170cb77615144981d18d07b5970a69ab6e18f5edf96ed0663:"
        }
      ]
    },
    {
      "id": "claim_0bb912cb3a9640c48496979a94cd5845",
      "statement": "Because dispatch uses multitask_strategy='interrupt', a thread never provisions two sandboxes concurrently, which removed the need for the old in-process busy-check, lock, and cross-process sentinel.",
      "evidence": [
        {
          "resource": "repo://agent/server.py#L572-L577",
          "version": "repo-lines-v1:sha256:d564e5a3918c0b06e4e11208a2f0f7ed8c0044ff3a33a04e0cbae86e0abdd927:"
