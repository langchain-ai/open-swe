  "claims": [
    {
      "id": "claim_f75cd879d07b45f29d210694a643b7cf",
      "statement": "GitHub webhook deliveries land on a single signed endpoint (POST /webhooks/github) that verifies the X-Hub-Signature-256 HMAC, ignores unsupported event types, and dispatches accepted handlers as FastAPI background tasks.",
      "evidence": [
        {
          "resource": "repo://openswe/github/routes.py#L30-L103",
          "version": "repo-lines-v1:sha256:34e689dea856db2b9580f81282462d497887f99e5660f6754bf857ab9f2ba540:"
        }
      ]
    },
    {
      "id": "claim_010d9ee483a14657a949f7760d5c5d4f",
      "statement": "Auto-review on PR opened/ready_for_review is scheduled only when the repository is opted into automatic review (via is_review_repo_enabled), delegating to is_review_repo_enabled which fails soft — an unreachable enabled-repos store reads as 'not opted in' and skips the review rather than erroring the webhook.",
      "evidence": [
        {
          "resource": "repo://openswe/review/enabled_repos.py#L40-L59",
          "version": "repo-lines-v1:sha256:4072ca9d609d1d9a2b52247ffc2377bed56abaed537e41b41d3cffffc53f0308:"
        }
      ]
    },
    {
      "id": "claim_03c71305c7784203baa873068ace69e4",
      "statement": "process_github_pr_ready skips auto-reviewing a draft PR unless the PR author's review_draft_prs profile flag (falling back to the team-wide default) enables draft reviews.",
      "evidence": [
        {
          "resource": "repo://openswe/github/webhook.py#L540-L555",
          "version": "repo-lines-v1:sha256:fe834a7acd10258426626f6b7fcd159887c6b8992fb007250df42f03a4ad66f8:"
        }
      ]
    },
    {
      "id": "claim_6b9cedc420284e77ad83cbaab5ec1e04",
      "statement": "An explicit review request enters through trigger_pr_review_from_ref, which fetches PR metadata to resolve base/head SHAs, sets reviewer thread metadata with watch=True, posts a review-started comment, and dispatches a reviewer run; request_pr_review is the agent tool that parses a PR URL and invokes it.",
      "evidence": [
        {
          "resource": "repo://openswe/github/webhook.py#L262-L393",
          "version": "repo-lines-v1:sha256:8d1582ba9a5729c1b57fd0cc9c306333e9c27204ad423800f8ee6ee2498e9bbf:"
        }
      ]
    },
    {
      "id": "claim_cf6d73688358435ca9d7d15e24d4fa6b",
      "statement": "Every review of a given PR runs on one deterministic thread id, reviewer_thread_id(owner, repo, pr_number), a UUIDv5 over '{owner}/{repo}/pr/{pr_number}/reviewer' that webhooks, the dashboard, and the reviewer all re-derive from the same identifiers to address the same thread; the formula is a persisted-data contract whose change would orphan live threads.",
      "evidence": [
        {
          "resource": "repo://openswe/thread_ids.py#L40-L42",
          "version": "repo-lines-v1:sha256:a1d0e52a5dbb2ef054e938e31fc9cee355919d1cfc94342606cd5b5ff9d19b20:"
        }
      ]
    },
    {
      "id": "claim_eb6dc3904eb54df4a9aa0143ab2b37d9",
      "statement": "Reviewer runs are dispatched with assistant_id='reviewer', which maps to the reviewer graph (openswe.graphs.reviewer:traced_reviewer_agent), and the dispatched run id is stored on reviewer thread metadata via store_current_reviewer_run_id.",
      "evidence": [
        {
          "resource": "repo://langgraph.json#L7-L7",
          "version": "repo-lines-v1:sha256:6230c78869d63631a82b1368f7f07625ab76032371b20e4588977266c2466a40:"
