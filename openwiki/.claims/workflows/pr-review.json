    {
      "id": "claim_461f9ff79f9b4874b75ab9013bf9a88b",
      "statement": "add_finding enforces in-diff-only discipline: it validates start_line..end_line against the diff line set for the file/side via is_range_in_diff and rejects out-of-diff findings with success:false and in_diff:false and an explicit do-not-retry message; file-level findings (both lines None) are accepted but do not render as inline comments.",
      "evidence": [
        {
          "resource": "repo://openswe/tools/add_finding.py#L60-L75",
          "version": "repo-lines-v1:sha256:74179a0ae855553ec6119b66c31de88706893128069b189bdec8eeb8e40325f3:"
        }
      ]
    },
    {
      "id": "claim_5080a69e1f924aa7b8af8404170dfcac",
      "statement": "add_finding requires a non-default generated title, validates severity/confidence/side enums, and clips suggestions longer than the 4-line cap (MAX_SUGGESTION_LINES) — dropping the suggestion while keeping the description-only finding.",
      "evidence": [
        {
          "resource": "repo://openswe/tools/add_finding.py#L41-L123",
          "version": "repo-lines-v1:sha256:74cbdee54f2d8adebb19f7854e3d38957199b20c94e44d6835e04433dc583752:"
        }
      ]
    },
    {
      "id": "claim_63861acb8731459882fd0254887c92c7",
      "statement": "Severity is ordered low < medium < high < critical (SEVERITY_ORDER); filter_findings_for_publish surfaces only open findings at or above the severity_threshold (default medium), sorted severity-descending then file/line. Confidence is recorded per finding but does not gate publication.",
      "evidence": [
        {
          "resource": "repo://openswe/review/findings.py#L105-L110",
          "version": "repo-lines-v1:sha256:27dedde688dc51855b030c1e493e0aef09e5e850543a7e9e849434b5b62e3de6:"
