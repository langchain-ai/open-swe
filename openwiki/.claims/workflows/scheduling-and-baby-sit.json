  "claims": [
    {
      "id": "claim_851e23a08e794421a0ac06c407e8a9d0",
      "statement": "The scheduler graph (openswe/scheduler.py) is a single-node StateGraph (START -> launch -> END) registered as the `scheduler` assistant in langgraph.json, and its `_launch` node deterministically routes one cron/run tick to the handler matching the incoming `task`, invoking no LLM.",
      "evidence": [
        {
          "resource": "repo://langgraph.json#L10-L10",
          "version": "repo-lines-v1:sha256:74e6933a0b2c59a70988019758a54f79f221148744ff2a1e0fdeab17e944d72b:"
        },
        {
          "resource": "repo://openswe/scheduler.py#L119-L124",
          "version": "repo-lines-v1:sha256:7eae2ce6201a24683071e835499d09005df0c8d0d8d38acb46978c32062d294d:"
        }
      ]
    },
    {
      "id": "claim_3682bb8bd72d486a95134e55f8c79184",
      "statement": "The scheduler's `_launch` routes `task` values `reconcile`, `baby_sit`, `background_tasks`, `session_cost`, `agent_cost`, `thread_feedback`, workspace refresh (full and incremental), announcements, expedited review, and human-review deadlines to their handlers, plus falls through to `launch_scheduled_agent_run(schedule_id)` when no task matches.",
      "evidence": [
        {
          "resource": "repo://openswe/scheduler.py#L61-L104",
          "version": "repo-lines-v1:sha256:78397c197be6ef897100d78d902b7c9aeced41ddc60655426a93cb3a1ac8725d:"
        }
      ]
    },
    {
      "id": "claim_d9afc0d3df954f499b1b1e919b41a09c",
      "statement": "When a scheduler tick is missing its required key (watch_key, thread_id, request_id, schedule_id, or other task-specific field), `_launch` returns a `missing_*` status result instead of raising, so a malformed tick degrades to a no-op rather than crashing the cron.",
      "evidence": [
        {
          "resource": "repo://openswe/scheduler.py#L65-L104",
          "version": "repo-lines-v1:sha256:1ae5b326091eda20e78f3a899649520eca0c9238517e1b1ce4fefce116a06821:"
        }
      ]
    },
