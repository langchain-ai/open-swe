      "id": "claim_228f71b6f1cc4669bd1e1b200cb4d0e8",
      "statement": "Open SWE schedules background work in a PostgreSQL job queue rather than through a scheduler graph: jobs name a kind and payload, may be one-shot or cron-based, and a non-null key upserts/replaces the existing logical job.",
      "evidence": [
        {
          "resource": "repo://openswe/jobs/queue.py#L137-L200",
          "version": "repo-lines-v1:sha256:e09e44a5a396387e484f55d6e4cf94df8425dd648f2f5a99a2152c920074552f:"
        }
      ]
    },
    {
      "id": "claim_0f68523ea174483ca76bbe6c68dfacfa",
      "statement": "The job worker claims due work with a 30-minute lease, runs at most 20 jobs concurrently, renews running claims every 10 seconds, cancels a handler if its job is cancelled, and retries failed one-shot jobs with bounded exponential backoff while advancing a failed cron to its next fire.",
      "evidence": [
        {
          "resource": "repo://openswe/jobs/queue.py#L25-L29",
