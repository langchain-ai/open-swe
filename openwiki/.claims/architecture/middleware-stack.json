    {
      "id": "claim_a5f5a575fd294f8d81eff9b1ec1703cd",
      "statement": "The reviewer graph installs a leaner middleware chain with no conversation offloading, transcript, incident, workspace skills, dynamic tools, tool validation, task retry, model selection, PR guard, workflow push guard, subdir-agents read hook, run-usage hook, or fallback; it uniquely adds RepairOrphanedToolCallsMiddleware and settle_review_check_on_exit, uses langchain's ModelRetryMiddleware for TimeoutError, and also installs ModelErrorMiddleware.",
      "evidence": [
        {
          "resource": "repo://openswe/reviewer.py#L1006-L1026",
          "version": "repo-lines-v1:sha256:76ba877bb3661c0bf03098d48ff5ba920dcb18fae3772e99a241ad7debcd45f0:"
        }
      ]
    },
