    {
      "id": "claim_d9665a135b28449686d20f6b5ac10e4c",
      "statement": "Open SWE passes ordered middleware to `create_deep_agent`; the coding-agent factory builds a conditional outer-to-inner stack that includes preparation, call limits, tool-error handling, policy guards, queue/event hooks, reply requirements, usage and model selection, fallback, model-shaping middleware, error recording, and an innermost model deadline.",
      "evidence": [
        {
          "resource": "repo://openswe/server.py#L2100-L2177",
          "version": "repo-lines-v1:sha256:4eced3901a5acbef0e786b1cd518a33a611d7fe593f455dd932285c23ff50585:"
        }
      ]
    },
    {
      "id": "claim_809214e184d743efa29ceae6b9e490a2",
      "statement": "`BasePrepareRunMiddleware` fingerprints the middleware class, latest message, and preparation configuration; its checkpointed `run_prepared_for` latch skips completed matching setup on resume, while `_prepare` must be idempotent because a pre-checkpoint failure can cause it to run again.",
      "evidence": [
        {
