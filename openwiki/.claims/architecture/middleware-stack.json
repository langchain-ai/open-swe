    {
      "id": "claim_5f37c6f3fd0d4b7daf65acc42b1cb6c1",
      "statement": "The coding-agent middleware order is outer-to-inner: ConversationOffloading, preparation, transcript, optional incident/workspace-skills, input and image validation, model-call limiting, tool error/exclusion/subdirectory/task retry, delivery policy guards, proxy and queue hooks, wrap-up and reply/CLI completion guards, step-limit and usage hooks, optional model selection/fallback/dynamic tools, message sanitizers, stable tool order, model-error recording, and the innermost model-call deadline.",
      "evidence": [
        {
          "resource": "repo://agent/server.py#L1594-L1708",
          "version": "repo-lines-v1:sha256:bddf60705015a692193207008bdaa611662cc02fefc6eee25fb52b33da128fe2:"
        }
      ]
    },
