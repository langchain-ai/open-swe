    {
      "id": "claim_b84ca73fa9ca440eaddd035980a5842f",
      "statement": "A thread’s durable sandbox binding is `sandbox_id` in thread metadata, while `SANDBOX_BACKENDS` is a worker-local map of stable per-thread proxies and `SANDBOX_CONNECTIONS` caches live connections by sandbox ID; metadata prefers qualifying inline run metadata then reads the live thread, and live lookup failures propagate rather than reading as unbound.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/state.py#L324-L406",
          "version": "repo-lines-v1:sha256:168060b601e0f8409490261ea4841a37ce251f2956a86e190fd69ef37626d8dd:"
        }
      ]
    },
