        }
      ]
    },
    {
      "id": "claim_6f6ba49c285f4c98ba4006e64c95def3",
      "statement": "Every run re-applies the git identity (bot user.name/user.email) because reused or reconnected sandboxes can lose their --global config and Vercel preview deploys reject commits whose author email cannot be resolved to a GitHub account.",
      "evidence": [
