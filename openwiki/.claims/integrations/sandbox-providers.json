    {
      "id": "claim_85a89a5c69bd4e8e8d4a89c2513ad2d5",
      "statement": "`SANDBOX_TYPE` defaults to `langsmith`; the registry lazily imports one of six registered factories (`langsmith`, `daytona`, `modal`, `runloop`, `e2b`, or `local`) and rejects unknown types with a `ValueError` that lists supported types. Daytona, Modal, Runloop, and E2B SDKs are optional extras, and selecting one without its SDK produces an installation-guidance `ValueError`.",
      "evidence": [
        {
          "resource": "repo://agent/config.py#L387-L401",
          "version": "repo-lines-v1:sha256:66e99905c50000315ddfe39baa0b0a48f62bec39e4c1a47920b28bad293375bf:"
