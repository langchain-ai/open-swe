    {
      "id": "claim_dbbc3ca9eca441849138011e70eadf76",
      "statement": "The dashboard backend is an APIRouter with prefix \"/dashboard/api\" and a router-level mutation-origin dependency; openswe/api/app.py includes it and then invokes mount_dashboard_ui(app).",
      "evidence": [
        {
          "resource": "repo://openswe/api/app.py#L153-L163",
          "version": "repo-lines-v1:sha256:ccfe154f44fccafa87c68733dc2e9d41a19958b9f1d4d795a29c8708e389c38b:"
        },
        {
