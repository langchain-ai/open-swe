        }
      ]
    },
    {
      "id": "claim_5137f84b36be4cd59aa0cf6c902aa4f2",
      "statement": "openswe/dashboard/__init__.py exposes the router lazily via a PEP 562 __getattr__ so that importing a dashboard submodule does not drag in routes.py, FastAPI, and every API/job module; only the webapp that mounts the router pays that import cost.",
      "evidence": [
        {
          "resource": "repo://openswe/dashboard/__init__.py#L17-L23",
          "version": "repo-lines-v1:sha256:561f70de0b0a1a56a480e3cc5cdf3fb3dee6c0673f7ba85e2ae3456ac315a56c:"
        }
      ]
    },
    {
      "id": "claim_1311bde23f634fc0aa3ffa2720da972a",
      "statement": "GitHub login creates signed state containing a hash of a nonce placed in a short-lived HTTP-only state cookie, then redirects to GitHub; the normal callback verifies the state cookie, exchanges the code, enforces the organization gate, persists the token, and issues a signed session cookie, while a desktop handoff returns a PKCE-bound code without setting that browser cookie.",
      "evidence": [
        {
          "resource": "repo://openswe/dashboard/auth_routes.py#L61-L198",
          "version": "repo-lines-v1:sha256:fd4ce5e94131bda3fae0c99730b155d7daa0ec86a99f89c3508a5e1d4d391251:"
        }
      ]
    },
    {
      "id": "claim_a9f05ddeca304982992bd67bdc104d6c",
      "statement": "Session cookie flags derive from the API scheme and whether dashboard and API are same-origin: HTTP is non-Secure SameSite=Lax, same-origin HTTPS is Secure SameSite=Lax, and split-origin HTTPS is Secure SameSite=None.",
      "evidence": [
        {
          "resource": "repo://openswe/dashboard/oauth.py#L614-L627",
          "version": "repo-lines-v1:sha256:e920efb94c3d1cf14508d3d2f5b8e1b7ce085c2e2a342cf38f9cacab139f48ff:"
        }
