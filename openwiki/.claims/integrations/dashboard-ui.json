    {
      "id": "claim_1311bde23f634fc0aa3ffa2720da972a",
      "statement": "GitHub login issues a signed state carrying a hashed nonce stored in a short-lived state cookie and redirects to GitHub's authorize URL; the callback validates the state nonce against the cookie, exchanges the code, enforces an organization login gate, persists the token, and issues a signed session JWT in the session cookie.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/routes.py#L450-L541",
          "version": "repo-lines-v1:sha256:ff70f8315a2b90cdca48ebca6a65ff4ac1ccb4b45f6571a91d27f48b6da4b357:"
        }
      ]
    },
    {
      "id": "claim_a9f05ddeca304982992bd67bdc104d6c",
      "statement": "Session cookie Secure/SameSite flags are derived from the API scheme: an HTTPS DASHBOARD_API_BASE_URL yields Secure; SameSite=None (cross-site production), otherwise local http falls back to SameSite=Lax without Secure.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/routes.py#L360-L370",
          "version": "repo-lines-v1:sha256:03d586f14fb56113d63e6068851bd5b26ff5c9390b2188328739a0063b4925ed:"
        }
      ]
    },
    {
      "id": "claim_412bfb0cc40b4b7aa5523becfe654a6b",
      "statement": "Every mutating dashboard request is guarded by the router-level dependency require_same_origin_for_mutations, which passes GET/HEAD/OPTIONS and bearer-token-only requests but rejects cookie-authenticated mutations whose Origin/Referer is not in the dashboard allowlist with a CSRF error.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/oauth.py#L364-L401",
          "version": "repo-lines-v1:sha256:5f9549985697afe54da821ef6dbeb870ef418e6494c07fc3fd32c0ed9af2d9f7:"
