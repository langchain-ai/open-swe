      "id": "claim_dbbc3ca9eca441849138011e70eadf76",
      "statement": "The dashboard backend is an APIRouter with prefix \"/dashboard/api\" and a router-level mutation-origin dependency; agent/api/app.py includes it and then invokes mount_dashboard_ui(app).",
      "evidence": [
        {
          "resource": "repo://agent/api/app.py#L91-L119",
          "version": "repo-lines-v1:sha256:a976ca7455f20603737536dfd08beab76fd415b2d848b168abc622845446c437:"
