    {
      "id": "claim_dbbc3ca9eca441849138011e70eadf76",
      "statement": "The dashboard backend is a single FastAPI APIRouter created in agent/dashboard/routes.py with prefix \"/dashboard/api\", and it is mounted onto the composed FastAPI app in agent/api/app.py via app.include_router(dashboard_router).",
      "evidence": [
        {
          "resource": "repo://agent/api/app.py#L10-L57",
          "version": "repo-lines-v1:sha256:586e91028f83296bb9081cafba70d83dfc86a14c88aefe90894589b394151dec:"
        },
        {
          "resource": "repo://agent/dashboard/routes.py#L256-L260",
          "version": "repo-lines-v1:sha256:b2142f8f7618bb20374837dc6826b6846f3ecbba64b027cb0d916ec6f3f35268:"
        }
      ]
    },
    {
      "id": "claim_5137f84b36be4cd59aa0cf6c902aa4f2",
      "statement": "agent/dashboard/__init__.py exposes the router lazily via a PEP 562 __getattr__ so that importing a dashboard submodule does not drag in routes.py, FastAPI, and every API/job module; only the webapp that mounts the router pays that import cost.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/__init__.py#L1-L23",
          "version": "repo-lines-v1:sha256:0a6e7700e895302fb121ce6945ffd27e5c790311259baaad98b661acf3f8e5ec:"
        }
      ]
    },
    {
      "id": "claim_5603ed45e5f245f4a5ca4e844446db14",
      "statement": "The dashboard router owns GitHub OAuth login/callback/logout, per-user profiles and credentials, admin endpoints, team settings/credentials and defaults, enabled review repositories, review-style management, agent instructions and skills, usage leaderboards, schedules, and the Agents thread API.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/routes.py#L1559-L1834",
