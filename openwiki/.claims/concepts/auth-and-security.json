        }
      ]
    },
    {
      "id": "claim_086dacb5251548bf8b1251136c2ff821",
      "statement": "GitHub tokens are cached only in process memory by thread and normalized user principal or a separate bot principal; unbound user tokens are not cached, and entries expire with a 60-second token-expiry skew or a 24-hour cap.",
      "evidence": [
