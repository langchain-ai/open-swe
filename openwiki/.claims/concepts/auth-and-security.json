    {
      "id": "claim_546378dd07a04b50822ce54a69069bb8",
      "statement": "resolve_github_token routes GitHub token resolution by run source: sources carrying a mapped GitHub login (slack, linear, dashboard, schedule) prefer the triggering user's per-user OAuth token from the dashboard store — even in bot-token-only mode — so PRs and comments are attributed to that user.",
      "evidence": [
        {
          "resource": "repo://openswe/credential_scope.py#L75-L83",
          "version": "repo-lines-v1:sha256:982bf582d4a7a7dd350f9fa37c2b349fdba6b362c62e1b59efd6d59c8e2fa556:"
        },
