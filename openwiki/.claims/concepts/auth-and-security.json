    {
      "id": "claim_9d5b6901eff547c4b3054df08d9769ed",
      "statement": "GitHub credential resolution is governed by persisted thread scope: public threads use a GitHub App installation token, while private threads can use a dashboard OAuth token only when the saved owner login matches the current actor; invalid scope metadata and private system threads are rejected, and a missing private token raises GitHubUserAuthRequired rather than falling back to bot authority.",
      "evidence": [
        {
          "resource": "repo://agent/credential_scope.py",
          "version": "repo-file-v1:sha256:4a8282ac5640ad9e0beb4782ed25d0a984e8ac1a17ec8be92c898795ca16a43e"
        },
        {
