    {
      "id": "claim_16867de3ca5946d1b3de2199f82d880f",
      "statement": "Resolved GitHub tokens are cached only in process memory keyed by (thread_id, principal), where the principal isolates one user's token from another (login:/email:) and a distinct bot principal isolates installation tokens; tokens are never persisted and caching an unbound user token with no principal is refused.",
      "evidence": [
        {
          "resource": "repo://openswe/github/thread_token.py#L50-L73",
          "version": "repo-lines-v1:sha256:d5ffefec1e33a708101a61d0598c8d69e577e7e2951913f29705d29251115140:"
        }
      ]
    },
    {
      "id": "claim_f8240e927a2643c596f1050141df2633",
      "statement": "Cached GitHub token entries expire on the token's own expiry (with a 60-second skew) or a hard 24-hour TTL cap, whichever comes first, and invalidate_cached_github_token clears a thread's entries when a stale/revoked token is detected.",
      "evidence": [
        {
          "resource": "repo://openswe/github/thread_token.py#L107-L114",
