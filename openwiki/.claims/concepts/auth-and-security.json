    {
      "id": "claim_9e2797da838d4e50ad56a5cb913245ae",
      "statement": "GitHub App installation tokens are cached in process memory by installation, repository, and permission scope until ten minutes before expiry; absent App configuration can use a gh CLI token only for local development and otherwise returns no token.",
