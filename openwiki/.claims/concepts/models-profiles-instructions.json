    {
      "id": "claim_6542ad2cef5747e9b221dffc6d2cf2e0",
      "statement": "The run factory in agent/server.py resolves the agent model/effort by starting from the team default and overriding upward in the order team default -> per-user profile override -> stored thread settings -> explicit per-thread run config, where an explicit per-thread agent_model_id is the only source allowed to move a thread off its stored settings and is then persisted back onto the thread.",
      "evidence": [
        {
          "resource": "repo://agent/server.py#L1452-L1512",
          "version": "repo-lines-v1:sha256:cd4d77eeb6e2991c4252be78cf119704646bc515b6ec2ccca80b2a56e12e6c16:"
        }
      ]
    },
    {
      "id": "claim_e59a92170ddb46c3bb8ad6afdb3a6042",
      "statement": "agent_overrides.resolve_agent_model_id and dashboard thread_api._resolve_agent_model_choice apply the same per-thread -> profile -> team-default precedence used by the run factory, for callers that resolve a model id outside the factory.",
      "evidence": [
