        }
      ]
    },
    {
      "id": "claim_bb46dfb2fe4042f588e5749237cf0336",
      "statement": "Retired model ids are migrated rather than discarded: DEPRECATED_MODEL_REPLACEMENTS maps them onto a replacement and canonical_model_pair applies that mapping (preserving effort when the replacement supports it), while provider_fallback_pair keeps an unsupported stored id on the same provider and, where possible, the same Claude family instead of falling through to the global default.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/options.py#L105-L122",
          "version": "repo-lines-v1:sha256:55e7516090daca90d1835f650dfb68538d5681e4f19b44b0d7e29d7b224d5ea5:"
