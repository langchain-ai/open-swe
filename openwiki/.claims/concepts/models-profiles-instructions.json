    {
      "id": "claim_16929e4192694f9e88e21b2df6f1eb58",
      "statement": "The global hardcoded fallback pair is DEFAULT_MODEL_ID/DEFAULT_MODEL_EFFORT exposed through default_model_pair(), used when no valid team default or same-provider fallback exists.",
      "evidence": [
