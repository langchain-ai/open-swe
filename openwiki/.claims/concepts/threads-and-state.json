  "claims": [
    {
      "id": "claim_59daaaa8396044a0ab47378f78878e79",
      "statement": "openswe/thread_ids.py is the single home for deterministic thread-id derivation, and every id is a cross-process routing contract that webhooks, the dashboard, and the reviewer each re-derive from the same external identifiers to find an existing thread, so changing a formula orphans live threads.",
      "evidence": [
        {
          "resource": "repo://openswe/thread_ids.py#L1-L7",
          "version": "repo-lines-v1:sha256:74407305d823d66ac0922ef8230aba3e627fd83f5284c729045a94b7992b419e:"
        }
      ]
    },
    {
      "id": "claim_3681e87a4b05434faa1958c0750175bb",
      "statement": "Thread ids are derived either as URL-namespaced UUIDv5 (Slack, PR-comment, reviewer, review-style, baby-sit-lock) via uuid.uuid5(NAMESPACE_URL, key), or as a SHA-256-derived UUID (Linear and GitHub issue ids) via _sha256_uuid.",
      "evidence": [
        {
          "resource": "repo://openswe/thread_ids.py#L33-L39",
          "version": "repo-lines-v1:sha256:21523c6c65881d364f26798fc993790b24fa71cf0c08c9e7ae5f64d1eceb9818:"
        }
      ]
    },
    {
      "id": "claim_e64f64c8bae24ee989219ae1057aabc8",
