    {
      "id": "claim_59daaaa8396044a0ab47378f78878e79",
      "statement": "agent/thread_ids.py is the single home for deterministic thread-id derivation, and every id is a cross-process routing contract that webhooks, the dashboard, and the reviewer re-derive from the same external identifiers to find an existing thread, so changing a formula orphans live threads.",
      "evidence": [
        {
          "resource": "repo://agent/thread_ids.py#L1-L37",
          "version": "repo-lines-v1:sha256:7427ac60fac29abde683855df98f82a505ed476b7cd006637c7ef5096234441a:"
        }
      ]
    },
    {
      "id": "claim_3681e87a4b05434faa1958c0750175bb",
      "statement": "Thread ids are derived either as URL-namespaced UUIDv5 (Slack, PR-comment, reviewer, review-style, review-scout, review-chat, and baby-sit-lock) via uuid.uuid5(NAMESPACE_URL, key), or as a SHA-256-derived UUID (Linear and GitHub issue ids) via _sha256_uuid.",
      "evidence": [
