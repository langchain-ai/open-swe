    {
      "id": "claim_11517f4004d84d74a9aa5799a8d72849",
      "statement": "All agent tools live as flat modules under agent/tools/ and are re-exported through agent/tools/__init__.py, which lazily imports each tool's submodule on first access via _TOOL_MODULES and a custom _LazyToolsModule/__getattr__ loader.",
      "evidence": [
        {
          "resource": "repo://agent/tools/__init__.py#L179-L206",
          "version": "repo-lines-v1:sha256:0b186303b85a5cffc53d95e4ab9e1510ffe421d7482d7dcae9cd7523c97098e9:"
        },
        {
