    {
      "id": "claim_0cebcad4ae1e40d1a29a4f11a525a698",
      "statement": "Open SWE separates responsibilities between a LangGraph/FastAPI backend and the independent `mda/` Managed Deep Agents project: the backend plans and signs run context/catalog data, while MDA runs the model loop, checkpoints, sandbox, tools, and middleware and calls typed backend endpoints under `/agent-api/{endpoint}` with the run token.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L14-L24",
          "version": "repo-lines-v1:sha256:b784a6c19f45d5b428def6cc738d441ceaf892600d216bc7df263c63ceb6240a:"
