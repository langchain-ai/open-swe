#!/bin/sh
# Git credential helper backed by the GitHub App installation token.
#
# Configured for https://github.com via speedbay/gitconfig. Git calls this with
# an operation argument ("get", "store", "erase"); only "get" needs to do work.
# GitHub accepts an installation token as the password with the fixed username
# "x-access-token".
set -eu

[ "${1:-}" = "get" ] || exit 0

HERE="$(cd "$(dirname "$0")" && pwd)"
TOKEN="$("$HERE/../../.venv/bin/python" "$HERE/../mint_token.py")"

printf 'username=x-access-token\n'
printf 'password=%s\n' "$TOKEN"
