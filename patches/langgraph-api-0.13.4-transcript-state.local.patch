+# open-swe local patch: hydrate a busy thread from its event stream.
+# The run worker publishes a full `values` event after every step into the
+# thread's event stream (the same tape the SSE endpoint replays). Replaying
+# it server-side and keeping only the last root `values` event gives the
+# current state without the checkpointer, plus the protocol `seq` a client
+# can pass as `since` so its own subscription starts at the live edge.
+# Replay from the stream backlog arrives as a burst; live events trickle. A
+# quiet gap after a minimum warm-up marks the live edge closely enough, and a
+# client resuming from the returned `seq` recovers anything after it anyway.
+_STREAM_SNAPSHOT_QUIET_SECONDS = 0.2
+_STREAM_SNAPSHOT_MIN_SECONDS = 0.3
+_STREAM_SNAPSHOT_MAX_SECONDS = 3.0
+
+
+async def _thread_state_from_stream(thread_id: str) -> ThreadState | None:
+    import asyncio  # noqa: PLC0415
+    from uuid import uuid4  # noqa: PLC0415
+
+    from langgraph_api.api.event_streaming import _make_manager  # noqa: PLC0415
+    from langgraph_api.event_streaming.types import Subscription  # noqa: PLC0415
+
+    snapshot: dict = {"values": None, "seq": 0, "step": None, "events": 0}
+    arrived = asyncio.Event()
+
+    async def on_event(event: dict) -> None:
+        seq = event.get("seq")
+        if isinstance(seq, int) and seq > snapshot["seq"]:
+            snapshot["seq"] = seq
+        params = event.get("params") or {}
+        if params.get("namespace"):
+            return
+        method = event.get("method")
+        if method == "values" and isinstance(params.get("data"), dict):
+            snapshot["values"] = params["data"]
+            snapshot["events"] += 1
+        elif method == "checkpoints" and isinstance(params.get("data"), dict):
+            step = params["data"].get("step")
+            if isinstance(step, int):
+                snapshot["step"] = step
+        arrived.set()
+
+    manager = _make_manager(thread_id, send_event=on_event)
+    manager.install_subscription(
+        Subscription(id=str(uuid4()), channels={"values", "checkpoints"}, active=False)
+    )
+    manager.start_thread_stream()
+    loop = asyncio.get_running_loop()
+    started = loop.time()
+    deadline = started + _STREAM_SNAPSHOT_MAX_SECONDS
+    try:
+        while loop.time() < deadline:
+            arrived.clear()
+            waiter = asyncio.create_task(arrived.wait())
+            ended = asyncio.create_task(manager.wait_for_thread_stream_end())
+            done, _ = await asyncio.wait(
+                {waiter, ended},
+                timeout=_STREAM_SNAPSHOT_QUIET_SECONDS,
+                return_when=asyncio.FIRST_COMPLETED,
+            )
+            for task in (waiter, ended):
+                if not task.done():
+                    task.cancel()
+            if ended in done:
+                break
+            if not done and loop.time() - started >= _STREAM_SNAPSHOT_MIN_SECONDS:
+                break
+    finally:
+        await manager.close()
+    if snapshot["values"] is None:
+        return None
+    metadata: dict = {"open_swe_transcript": {"stream_since": snapshot["seq"], "stream_values_events": snapshot["events"]}}
+    if snapshot["step"] is not None:
+        metadata["step"] = snapshot["step"]
+    return {
+        "values": snapshot["values"],
+        "next": ["__stream__"],
+        "tasks": [],
+        "metadata": metadata,
+        "created_at": None,
+        "checkpoint": None,
+        "parent_checkpoint": None,
+        "interrupts": [],
+        "checkpoint_id": None,
+        "parent_checkpoint_id": None,
+    }
+
+
