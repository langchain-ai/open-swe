+# --- open-swe local patch: transcript view -----------------------------------
+# A first-paint projection of ``values["messages"]``: human content, assistant
+# text and tool calls, tool statuses. Tool results, reasoning and provider
+# metadata are dropped and marked so a client can fetch them on demand.
+
+TRANSCRIPT_TRIMMED_MARKER = "open_swe_trimmed"
+
+
+def _transcript_text_content(content: object) -> object:
+    if isinstance(content, str):
+        return content
+    if not isinstance(content, list):
+        return ""
+    kept = [b for b in content if isinstance(b, dict) and b.get("type") == "text"]
+    return kept or ""
+
+
+def trim_transcript_message(message: object) -> dict | None:
+    if not isinstance(message, dict):
+        return None
+    kind = message.get("type")
+    if kind == "human":
+        out = {"type": "human", "id": message.get("id"), "content": message.get("content")}
+        if message.get("name") is not None:
+            out["name"] = message["name"]
+        if isinstance(message.get("additional_kwargs"), dict) and message["additional_kwargs"]:
+            out["additional_kwargs"] = message["additional_kwargs"]
+        return out
+    if kind == "ai":
+        out = {
+            "type": "ai",
+            "id": message.get("id"),
+            "content": _transcript_text_content(message.get("content")),
+            "tool_calls": message.get("tool_calls") or [],
+        }
+        if message.get("name") is not None:
+            out["name"] = message["name"]
+        rm = message.get("response_metadata")
+        if isinstance(rm, dict) and "created_at" in rm:
+            out["response_metadata"] = {"created_at": rm["created_at"]}
+        ak = message.get("additional_kwargs")
+        if isinstance(ak, dict) and "lc_source" in ak:
+            out["additional_kwargs"] = {"lc_source": ak["lc_source"]}
+        return out
+    if kind == "tool":
+        out = {
+            "type": "tool",
+            "id": message.get("id"),
+            "name": message.get("name"),
+            "tool_call_id": message.get("tool_call_id"),
+            "status": message.get("status", "success"),
+            "content": "",
+            "additional_kwargs": {TRANSCRIPT_TRIMMED_MARKER: True},
+        }
+        art = message.get("artifact")
+        if isinstance(art, dict) and "className" in art:
+            out["artifact"] = {"className": art["className"]}
+        return out
+    return None
+
+
+def trim_transcript_messages(messages: object) -> list[dict]:
+    if not isinstance(messages, list):
+        return []
+    return [m for m in (trim_transcript_message(x) for x in messages) if m is not None]
+
+
+def thread_state_transcript_view(state: ThreadState) -> ThreadState:
+    values = state.get("values")
+    if isinstance(values, dict) and "messages" in values:
+        messages = trim_transcript_messages(values["messages"])
+        state = {**state, "values": {**values, "messages": messages}}
+        metadata = dict(state.get("metadata") or {})
+        existing = metadata.get("open_swe_transcript")
+        metadata["open_swe_transcript"] = {**(existing if isinstance(existing, dict) else {}), "messages": len(messages)}
+        state["metadata"] = metadata
+    return state
+
+
+def thread_row_to_thread_state(thread: dict) -> ThreadState:
+    """A ThreadState from a thread row: the latest checkpoint's values while idle."""
+    interrupts = thread.get("interrupts") or {}
+    return {
+        "values": thread.get("values") or {},
+        "next": [],
+        "tasks": [],
+        "metadata": {k: v for k, v in (thread.get("metadata") or {}).items() if k in ("graph_id", "assistant_id")},
+        "created_at": thread.get("state_updated_at") or thread.get("updated_at"),
+        "checkpoint": None,
+        "parent_checkpoint": None,
+        "interrupts": [i for pending in interrupts.values() if isinstance(pending, list) for i in pending],
+        "checkpoint_id": None,
+        "parent_checkpoint_id": None,
+    }
