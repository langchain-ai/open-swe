{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": [
        ".output/**",
        ".vercel/output/**",
        "build/**"
      ],
      "env": [
        "DASHBOARD_API_URL",
        "VERCEL",
        "E2E_HARNESS",
        "VITE_*"
      ]
    },
    "typecheck": {},
    "test": {},
    "check": {
      "cache": false
    }
  }
}
