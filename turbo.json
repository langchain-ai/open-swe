{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": [
        ".output/**",
        ".vercel/output/**",
        "build/**",
        "dist/**"
      ],
      "env": [
        "DASHBOARD_API_URL",
        "VERCEL",
        "E2E_HARNESS",
        "VITE_*"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "check": {
      "cache": false
    }
  }
}
