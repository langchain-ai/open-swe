{$DOMAIN} {
	encode zstd gzip

	# Backend: webhooks, dashboard API, health.
	handle /webhooks/* {
		reverse_proxy backend:2024
	}
	handle /dashboard/api/* {
		reverse_proxy backend:2024
	}
	handle /health {
		reverse_proxy backend:2024
	}

	# Everything else: the dashboard UI (TanStack Start SSR server).
	handle {
		reverse_proxy ui:3000
	}
}
