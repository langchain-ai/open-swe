#!/usr/bin/env bash
set -euxo pipefail

APP_DIR=/opt/open-swe
SRC_DIR="$APP_DIR/src"
COMPOSE_DIR="$SRC_DIR/deploy/gce-simple/files"

install -d "$APP_DIR"

# Docker + compose plugin (idempotent across reboots).
if ! command -v docker >/dev/null 2>&1; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y ca-certificates curl git
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
    > /etc/apt/sources.list.d/docker.list
  apt-get update
  apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  systemctl enable --now docker
fi

# Clone or update the repo at the pinned ref.
if [ -d "$SRC_DIR/.git" ]; then
  git -C "$SRC_DIR" fetch --depth 1 origin "${repo_ref}"
  git -C "$SRC_DIR" checkout FETCH_HEAD
else
  git clone --depth 1 --branch "${repo_ref}" "${repo_url}" "$SRC_DIR" \
    || git clone "${repo_url}" "$SRC_DIR"
  git -C "$SRC_DIR" checkout "${repo_ref}"
fi

# SOPS for decrypting the secrets file (KMS-backed, via the instance SA's ADC).
if ! command -v sops >/dev/null 2>&1; then
  arch="$(dpkg --print-architecture)"
  curl -fsSL "https://github.com/getsops/sops/releases/download/v3.11.0/sops-v3.11.0.linux-$${arch}" -o /usr/local/bin/sops
  chmod 0755 /usr/local/bin/sops
fi

# The SOPS-encrypted secrets arrive as instance metadata. It may be empty on the
# very first apply (before the file exists); wait for it so the instance
# self-heals once `terraform apply` ships the ciphertext.
meta() {
  curl -sf -H 'Metadata-Flavor: Google' \
    "http://metadata.google.internal/computeMetadata/v1/instance/attributes/$1"
}

for _ in $(seq 1 60); do
  if meta sops-secrets > "$APP_DIR/secrets.enc.yaml" && [ -s "$APP_DIR/secrets.enc.yaml" ]; then
    break
  fi
  echo "waiting for sops-secrets metadata ..."
  sleep 15
done

# Decrypt to JSON, then emit a .env. json.dumps quotes each value and escapes
# newlines, so multiline secrets (the GitHub App private key) round-trip via
# python-dotenv's double-quote escape handling when langgraph loads .env.
sops -d --output-type json "$APP_DIR/secrets.enc.yaml" \
  | python3 -c 'import sys,json; d=json.load(sys.stdin); sys.stdout.write("".join(f"{k}={json.dumps(str(v))}\n" for k,v in d.items()))' \
  > "$APP_DIR/.env"

# Domain + ACME email for Caddy come from Terraform, appended so they always win.
{
  echo "DOMAIN=${domain}"
  echo "ACME_EMAIL=${acme_email}"
} >> "$APP_DIR/.env"

cd "$COMPOSE_DIR"
docker compose --env-file "$APP_DIR/.env" up -d --build
