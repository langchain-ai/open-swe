# Backend .env for the single-box deploy. Fill this in, then load it into
# Secret Manager (the instance fetches the latest version at boot):
#
#   gcloud secrets versions add open-swe-env --data-file=.env --project=<project>
#
# See ../../../docs/INSTALLATION.md for how to obtain each value. Only the
# sections for the triggers you use are required.
#
# NOTE: DOMAIN and ACME_EMAIL are appended automatically from Terraform at boot
# — you do not need to set them here. The domain-derived URLs below MUST match
# your Terraform `domain`.

# === LangSmith ===
LANGSMITH_API_KEY_PROD=""
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_PROJECT="open-swe-agent"
LANGSMITH_TENANT_ID_PROD=""
LANGSMITH_TRACING_PROJECT_ID_PROD=""
LANGSMITH_URL_PROD="https://smith.langchain.com"

# === LLM ===
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# === GitHub App (required) ===
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----
"
GITHUB_APP_INSTALLATION_ID=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""

# === Repo allowlist / defaults ===
ALLOWED_GITHUB_ORGS=""
ALLOWED_GITHUB_REPOS=""
DEFAULT_REPO_OWNER=""
DEFAULT_REPO_NAME=""

# === Dashboard (same-origin behind Caddy) ===
# Replace open-swe.example.com with your Terraform `domain`.
DASHBOARD_API_BASE_URL="https://open-swe.example.com"
DASHBOARD_BASE_URL="https://open-swe.example.com"
DASHBOARD_JWT_SECRET=""
# Same-origin, so CORS/allowed-origins is not needed; set it if you add a
# separate frontend origin.
DASHBOARD_ALLOWED_ORIGINS=""
CONFIGURED_ADMINS=""
# Backend is reached by Caddy over the compose network.
LANGGRAPH_URL="http://backend:2024"

# === Sandbox ===
SANDBOX_TYPE="langsmith"
DEFAULT_SANDBOX_SNAPSHOT_ID=""

# === Token encryption (required) ===
TOKEN_ENCRYPTION_KEY=""

# === Linear (optional) ===
LINEAR_API_KEY=""
LINEAR_WEBHOOK_SECRET=""

# === Slack (optional) ===
SLACK_BOT_TOKEN=""
SLACK_BOT_USER_ID=""
SLACK_BOT_USERNAME=""
SLACK_SIGNING_SECRET=""

# === Web search (optional) ===
EXA_API_KEY=""
