project_id = "my-gcp-project"
region     = "us-central1"
zone       = "us-central1-a"

domain     = "open-swe.example.com"
acme_email = "you@example.com"

# Restrict SSH in production, e.g. ["203.0.113.10/32"].
ssh_source_ranges = ["0.0.0.0/0"]

# Optional: pin a ref other than main.
# repo_ref = "v1.2.3"

# IAM members who can edit secrets locally with `sops` (encrypt+decrypt on the
# SOPS KMS key). The VM itself only needs decrypt and is granted automatically.
sops_operators = ["user:you@example.com"]
